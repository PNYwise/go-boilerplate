# Application Settings
APP_NAME=example_app

#HTTP mode configuration
HTTP_ADDR=0.0.0.0:8080

#GRPC mode configuration
# GRPC_ADDR=0.0.0.0:9090

#Rabbit consumer mode configuration
# RABBIT_URL=amqp://guest:guest@localhost:5672/
# RABBIT_EXCHANGE=my_exchange
# RABBIT_QUEUE=my_queue
# RABBIT_ROUTING_KEYS=key1,key2,key3
# RABBIT_PREFETCH=10

# RABBIT_RETRY_TTL_MS=60000
# RABBIT_MAX_REDELIVERIES=5
# RABBIT_DLX=my_dlx
# RABBIT_RETRY_EXCHANGE=my_retry_exchange

# Database Settings
DB_USER=myuser
DB_PASSWORD=mypassword
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydb

DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MIN=30

# OpenTelemetry & ELK Stack Configuration
OTEL_SERVICE_NAME=example_app
OTEL_SERVICE_VERSION=1.0.0
OTEL_ENVIRONMENT=production

# ELK Stack Integration Options:
# Option 1: Direct to Elasticsearch OTLP receiver
# OTEL_EXPORTER_OTLP_ENDPOINT=http://elasticsearch:4318

# Option 2: Via OpenTelemetry Collector (recommended)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Option 3: Elastic APM Server
# OTEL_EXPORTER_OTLP_ENDPOINT=https://your-cluster.apm.elastic-cloud.com:443
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer your-secret-token

# Option 4: Self-hosted Elastic APM
# OTEL_EXPORTER_OTLP_ENDPOINT=https://apm-server.yourcompany.com:8200
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer your-secret-token,Custom-Header=value

# Batch processing settings
OTEL_BSP_SCHEDULE_DELAY=5
OTEL_BSP_EXPORT_TIMEOUT=30

